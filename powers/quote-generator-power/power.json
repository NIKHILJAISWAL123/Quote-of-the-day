{
  "id": "quote-generator-power",
  "name": "Quote Generator Power",
  "version": "1.0.0",
  "description": "AI-powered quote generation, analysis, and management Kiro Power. Generate original quotes, analyze meaning, categorize intelligently, and get productivity insights.",
  "keywords": [
    "quotes",
    "inspiration",
    "ai-generation",
    "productivity",
    "motivation",
    "wisdom",
    "leadership"
  ],
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com",
    "url": "https://github.com/yourusername"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/quote-generator-power"
  },
  "homepage": "https://github.com/yourusername/quote-generator-power",
  "bugs": {
    "url": "https://github.com/yourusername/quote-generator-power/issues"
  },
  "documentation": "https://github.com/yourusername/quote-generator-power/blob/main/README.md",
  "triggers": [
    {
      "keyword": "quote",
      "description": "Generate and manage inspirational quotes",
      "examples": [
        "generate a motivation quote",
        "analyze this quote",
        "categorize: The only way to do great work is to love what you do."
      ]
    },
    {
      "keyword": "inspiration",
      "description": "Get inspired with AI-generated quotes",
      "examples": [
        "give me inspiration for today",
        "I need a funny quote",
        "success quote please"
      ]
    },
    {
      "keyword": "daily-quote",
      "description": "Get today's inspirational quote",
      "examples": [
        "what's my quote for today",
        "give me today's wisdom",
        "daily motivation"
      ]
    },
    {
      "keyword": "productivity",
      "description": "Get productivity tips based on quotes",
      "examples": [
        "help me be more productive",
        "productivity tips for this week",
        "how can I improve my focus"
      ]
    }
  ],
  "skills": [
    {
      "id": "quote-generation",
      "name": "Quote Generation",
      "description": "Generate original quotes using AI with customizable categories and styles",
      "file": "skills/quote-generation.md",
      "tags": ["generation", "ai", "creative"]
    },
    {
      "id": "quote-analysis",
      "name": "Quote Analysis",
      "description": "Analyze quotes for meaning, emotional impact, and category classification",
      "file": "skills/quote-analysis.md",
      "tags": ["analysis", "interpretation", "insight"]
    },
    {
      "id": "quote-categorization",
      "name": "Smart Categorization",
      "description": "Automatically categorize quotes into motivation, success, wisdom, leadership, etc.",
      "file": "skills/quote-categorization.md",
      "tags": ["categorization", "organization", "classification"]
    },
    {
      "id": "productivity-tips",
      "name": "Productivity Tips",
      "description": "Generate context-aware productivity suggestions based on quote themes",
      "file": "skills/productivity-tips.md",
      "tags": ["productivity", "advice", "actionable"]
    }
  ],
  "steeringFiles": [
    {
      "id": "quote-best-practices",
      "name": "Quote Analysis Best Practices",
      "description": "Guidelines for effective quote generation and analysis",
      "file": "steering/quote-best-practices.md",
      "inclusion": "auto"
    }
  ],
  "tools": [
    {
      "name": "generateQuote",
      "description": "Generate an original quote for a given category",
      "category": "generation",
      "parameters": {
        "category": {
          "type": "string",
          "enum": [
            "motivation",
            "success",
            "funny",
            "wisdom",
            "leadership",
            "other"
          ],
          "description": "Quote category"
        },
        "style": {
          "type": "string",
          "description": "Optional style: inspirational, humorous, philosophical, motivational, authoritative"
        },
        "context": {
          "type": "string",
          "description": "Optional context for personalization"
        }
      }
    },
    {
      "name": "analyzeQuote",
      "description": "Analyze a quote for meaning and emotional impact",
      "category": "analysis",
      "parameters": {
        "text": {
          "type": "string",
          "description": "The quote text to analyze"
        },
        "author": {
          "type": "string",
          "description": "Optional author attribution"
        },
        "depth": {
          "type": "string",
          "enum": ["basic", "detailed", "comprehensive"],
          "description": "Analysis depth level"
        }
      }
    },
    {
      "name": "categorizeQuote",
      "description": "Auto-categorize a quote into one of the 6 categories",
      "category": "categorization",
      "parameters": {
        "text": {
          "type": "string",
          "description": "The quote text"
        },
        "returnAlternatives": {
          "type": "boolean",
          "description": "Also return alternative category suggestions"
        }
      }
    },
    {
      "name": "suggestProductivityTips",
      "description": "Get productivity suggestions based on quote or context",
      "category": "productivity",
      "parameters": {
        "quote": {
          "type": "string",
          "description": "Optional quote to base suggestions on"
        },
        "context": {
          "type": "string",
          "description": "Current situation or challenge"
        },
        "format": {
          "type": "string",
          "enum": ["quick", "detailed", "actionable"],
          "description": "Response format"
        }
      }
    }
  ],
  "mcpServers": [
    "claude-ai"
  ],
  "requirements": {
    "mcpRequired": true,
    "minimumKiroVersion": "1.0.0"
  },
  "config": {
    "cacheResponses": true,
    "cacheTTL": 86400,
    "rateLimit": {
      "perMinute": 10,
      "perHour": 100,
      "perDay": 500
    },
    "fallbackBehavior": "use-local-quotes"
  },
  "permissions": {
    "requiresMCP": true,
    "requiresFileSystem": false,
    "requiresNetwork": true,
    "agentsAllowed": ["ai-assistant-agent"]
  },
  "examples": [
    {
      "trigger": "quote",
      "input": "generate a motivation quote for Monday",
      "output": "Every Monday is a fresh opportunity to build the life you want."
    },
    {
      "trigger": "quote",
      "input": "analyze: Success is a journey, not a destination",
      "output": "This quote emphasizes continuous growth and process-focus over end goals..."
    },
    {
      "trigger": "productivity",
      "input": "help me improve focus this week",
      "output": "Based on focus and concentration, here are your weekly strategies..."
    }
  ],
  "changelog": {
    "1.0.0": {
      "date": "2026-09-29",
      "changes": [
        "Initial release",
        "4 core skills: generation, analysis, categorization, productivity",
        "MCP integration with Claude AI",
        "Property-based testing",
        "Rate limiting and caching"
      ]
    }
  },
  "support": {
    "issues": "https://github.com/yourusername/quote-generator-power/issues",
    "discussions": "https://github.com/yourusername/quote-generator-power/discussions",
    "documentation": "https://github.com/yourusername/quote-generator-power/wiki"
  }
}
